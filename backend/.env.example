# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Use a long random value in staging and production.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# File-backed development database. Use an absolute path in production-like environments.
DATA_FILE=./data/reko-db.json

# Wema integration. "mock" runs locally without bank credentials.
WEMA_MODE=mock
WEMA_API_BASE_URL=https://api.example.wemabank.com
WEMA_CLIENT_ID=
WEMA_CLIENT_SECRET=
WEMA_WEBHOOK_SECRET=

# Payout mode. "ledger" writes to the internal wallet ledger only.
PAYOUT_MODE=ledger
