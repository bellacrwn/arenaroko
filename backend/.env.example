# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
# Server only. Never expose this key to Vite or browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_STORAGE_BUCKET=pickup-photos

# Wema integration. "mock" works while developing the approved live adapter.
WEMA_MODE=mock
WEMA_API_BASE_URL=https://api.example.wemabank.com
WEMA_CLIENT_ID=
WEMA_CLIENT_SECRET=
WEMA_WEBHOOK_SECRET=

# "ledger" records wallet movement in Supabase without calling an external payout provider.
PAYOUT_MODE=ledger
